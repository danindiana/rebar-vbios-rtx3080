digraph G {
rankdir=LR;
label=<SELECTIVE ENABLEMENT CONTROL PLANE<BR/><FONT POINT-SIZE="12">How a vendor could implement compliant capability tiers using software/firmware channels</FONT>>;

graph [
  bgcolor="#05070d",
  color="#2ee6ff",
  fontname="DejaVu Sans",
  fontcolor="#f8fafc",
  fontsize=18,
  labelloc="t",
  margin=0.2,
  nodesep=0.45,
  ranksep=0.65,
  pad=0.25,
  outputorder="edgesfirst",
  splines=ortho
];
node [
  shape=box,
  style="rounded,filled",
  fontname="DejaVu Sans",
  fontsize=12,
  color="#38d9ff",
  penwidth=1.5,
  fillcolor="#111827",
  fontcolor="#f8fafc",
  margin="0.12,0.08"
];
edge [
  color="#94a3b8",
  fontname="DejaVu Sans",
  fontsize=10,
  fontcolor="#cbd5e1",
  arrowsize=0.8,
  penwidth=1.3
];


silicon [label=<Common silicon capability<BR/><FONT POINT-SIZE="10">compute blocks, VRAM, PCIe endpoint, possible BAR sizes</FONT>>, fillcolor="#0f172a", color="#38d9ff"];
policy [label=<Product / compliance policy matrix<BR/><FONT POINT-SIZE="10">market, SKU, customer class, license status, support tier</FONT>>, fillcolor="#1e1b4b", color="#a78bfa"];

subgraph cluster_configs {
  label="Configuration artifacts"; fontcolor="#f8fafc"; color="#334155"; style="rounded,dashed";
  vbios_full [label=<Full-capability VBIOS<BR/><FONT POINT-SIZE="10">large BAR, full interconnect, datacenter profile</FONT>>, fillcolor="#064e3b", color="#34d399"];
  vbios_mid [label=<Consumer / gaming VBIOS<BR/><FONT POINT-SIZE="10">feature gated until platform validation / update</FONT>>, fillcolor="#172554", color="#60a5fa"];
  vbios_export [label=<Compliant export VBIOS / SKU<BR/><FONT POINT-SIZE="10">reduced transfer / interconnect / feature envelope</FONT>>, fillcolor="#451a03", color="#f59e0b"];
  driver_gate [label=<Driver / runtime gates<BR/><FONT POINT-SIZE="10">device ID, firmware version, platform state, license policy</FONT>>, fillcolor="#12221b", color="#34d399"];
}

channels [label=<Distribution channels<BR/><FONT POINT-SIZE="10">OEM updater, driver branch, support portal, factory image</FONT>>, fillcolor="#0f172a", color="#38d9ff"];
market [label=<Installed system behavior<BR/><FONT POINT-SIZE="10">capabilities exposed only if policy + firmware + platform agree</FONT>>, fillcolor="#3b0764", color="#e879f9"];
audit [label=<Audit / verification<BR/><FONT POINT-SIZE="10">device ID, subsystem ID, BAR1 size, transfer rate, support logs</FONT>>, fillcolor="#2a0f14", color="#fb7185"];

silicon -> policy;
policy -> vbios_full; policy -> vbios_mid; policy -> vbios_export; policy -> driver_gate;
vbios_full -> channels; vbios_mid -> channels; vbios_export -> channels; driver_gate -> channels;
channels -> market -> audit;
}
