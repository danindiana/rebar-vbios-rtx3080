digraph G {
rankdir=TB;
label=<REBAR AS A FIRMWARE-GATED CAPABILITY<BR/><FONT POINT-SIZE="12">Same silicon, different platform negotiation result</FONT>>;

graph [
  bgcolor="#05070d",
  color="#2ee6ff",
  fontname="DejaVu Sans",
  fontcolor="#f8fafc",
  fontsize=18,
  labelloc="t",
  margin=0.2,
  nodesep=0.45,
  ranksep=0.65,
  pad=0.25,
  outputorder="edgesfirst",
  splines=ortho
];
node [
  shape=box,
  style="rounded,filled",
  fontname="DejaVu Sans",
  fontsize=12,
  color="#38d9ff",
  penwidth=1.5,
  fillcolor="#111827",
  fontcolor="#f8fafc",
  margin="0.12,0.08"
];
edge [
  color="#94a3b8",
  fontname="DejaVu Sans",
  fontsize=10,
  fontcolor="#cbd5e1",
  arrowsize=0.8,
  penwidth=1.3
];


silicon [label=<GPU silicon capability<BR/><FONT POINT-SIZE="10">endpoint can expose larger BAR sizes</FONT>>, fillcolor="#0f172a", color="#38d9ff"];
pcisig [label=<PCIe Resizable BAR capability<BR/><FONT POINT-SIZE="10">device reports supported resource sizes; software programs size</FONT>>, fillcolor="#172554", color="#60a5fa"];

subgraph cluster_stack {
  label="Platform enablement stack"; fontcolor="#f8fafc"; color="#334155"; style="rounded,dashed";
  mobo [label=<Motherboard UEFI / SBIOS<BR/><FONT POINT-SIZE="10">Above 4G + Resizable BAR allocation</FONT>>, fillcolor="#12221b", color="#34d399"];
  vbios [label=<GPU VBIOS<BR/><FONT POINT-SIZE="10">advertises / permits BAR profile for board variant</FONT>>, fillcolor="#12221b", color="#34d399"];
  driver [label=<NVIDIA driver<BR/><FONT POINT-SIZE="10">validates device, configures runtime behavior</FONT>>, fillcolor="#12221b", color="#34d399"];
  os [label=<OS PCI resource manager<BR/><FONT POINT-SIZE="10">assigns address space after firmware init</FONT>>, fillcolor="#12221b", color="#34d399"];
}

bad [label=<Legacy / limited path<BR/><FONT POINT-SIZE="10">BAR1 ≈ 256 MiB; many visibility epochs</FONT>>, fillcolor="#2a0f14", color="#fb7185"];
good [label=<Enabled path<BR/><FONT POINT-SIZE="10">BAR1 ≈ 8192 MiB on 10 GiB RTX 3080; few epochs</FONT>>, fillcolor="#064e3b", color="#34d399"];
verify [label=<Verification<BR/><FONT POINT-SIZE="10">nvidia-smi -q on both GPUs + lspci ReBAR</FONT>>, fillcolor="#451a03", color="#f59e0b"];

silicon -> pcisig -> mobo -> vbios -> os -> driver;
vbios -> bad [label="old / restricted board ROM", color="#fb7185"];
driver -> good [label="correct board ROM + platform support", color="#34d399"];
good -> verify;
bad -> verify [style=dashed];
}
